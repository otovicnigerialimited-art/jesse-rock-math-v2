# ---------------------------------------------------------
# Jesse Rock Math - Environment Configuration Template
# ---------------------------------------------------------

# FRONTEND CONFIGURATION (Public Identifiers)
# These are exposed to the client bundle and used by the Firebase SDK.
# Security is maintained via server-side Firestore Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# BACKEND SECRETS (ZERO-EXPOSURE)
# These are NEVER sent to the browser.
# The server will FAIL TO START if these are missing.
GEMINI_API_KEY=
LEADERBOARD_SECRET=

# INFRASTRUCTURE
NODE_ENV=production
APP_URL="https://jesse-math-rockstar-app.vercel.app/"
