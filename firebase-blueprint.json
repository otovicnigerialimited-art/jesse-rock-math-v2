{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "role": { "type": "string" },
        "accountType": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastLoginAt": { "type": "number" },
        "streak": { "type": "number" },
        "xp": { "type": "number" },
        "coins": { "type": "number" }
      },
      "required": ["username"]
    },
    "School": {
      "title": "School",
      "description": "School information",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile",
      "type": "object",
      "properties": {
        "teacher_name": { "type": "string" },
        "email": { "type": "string" },
        "created_at": { "type": "number" }
      },
      "required": ["teacher_name", "email"]
    },
    "SchoolStudent": {
      "title": "SchoolStudent",
      "description": "Student profile managed by teacher",
      "type": "object",
      "properties": {
        "real_first_name": { "type": "string" },
        "username": { "type": "string" },
        "teacher_id": { "type": "string" },
        "school_math_progress": { "type": "object" },
        "xp": { "type": "number" },
        "coins": { "type": "number" }
      },
      "required": ["username", "real_first_name", "teacher_id"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "An entry on the public leaderboard collection",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "score": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["username", "score"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Classroom metadata",
      "type": "object",
      "properties": {
        "class_name": { "type": "string" },
        "school_id": { "type": "string" },
        "teacherId": { "type": "string" }
      }
    },
    "ClassSession": {
      "title": "ClassSession",
      "description": "Live class session state",
      "type": "object",
      "properties": {
        "teacher_id": { "type": "string" },
        "topic": { "type": "string" }
      }
    },
    "StudentHelpRequest": {
      "title": "StudentHelpRequest",
      "description": "Help request from student isolated to authorized teacher",
      "type": "object",
      "properties": {
        "student_name": { "type": "string" },
        "student_id": { "type": "string" },
        "teacher_id": { "type": "string" },
        "topic": { "type": "string" }
      }
    },
    "HomeworkAssignment": {
      "title": "HomeworkAssignment",
      "description": "Assigned homework task",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "teacher_id": { "type": "string" }
      }
    },
    "ExitTicket": {
      "title": "ExitTicket",
      "description": "Lesson closure exit ticket",
      "type": "object",
      "properties": {
        "topic": { "type": "string" },
        "teacher_id": { "type": "string" }
      }
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Custom created test or assessment",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "teacher_id": { "type": "string" }
      }
    },
    "StudentJourneyEvent": {
      "title": "StudentJourneyEvent",
      "description": "Student activity replay timeline event",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "student_id": { "type": "string" },
        "teacher_id": { "type": "string" }
      }
    },
    "SecurityAuditLog": {
      "title": "SecurityAuditLog",
      "description": "Security audit record for administrative events",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "teacher_id": { "type": "string" },
        "student_id": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["action", "timestamp"]
    },
    "Review": {
      "title": "Review",
      "description": "User review and rating for Jesse Math Rockstar",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "rating": { "type": "number" },
        "reviewText": { "type": "string" },
        "createdAt": { "type": "string" },
        "verifiedPlayer": { "type": "boolean" },
        "role": { "type": "string" }
      },
      "required": ["userId", "displayName", "rating", "reviewText", "createdAt", "verifiedPlayer"]
    },
    "SurveyResponse": {
      "title": "SurveyResponse",
      "description": "Anonymized structured user feedback response",
      "type": "object",
      "properties": {
        "bugsEncountered": { "type": "string" },
        "performanceRating": { "type": "string" },
        "topMissingFeature": { "type": "string" },
        "shopFeedback": { "type": "string" },
        "developerPriority": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["bugsEncountered", "performanceRating", "topMissingFeature", "shopFeedback", "developerPriority", "createdAt"]
    }
  },
  "firestore": {
    "/usernames/{username}": { "schema": "User", "description": "Usernames registry" },
    "/users/{userId}": { "schema": "User", "description": "Users collection" },
    "/schools/{schoolId}": { "schema": "School", "description": "Schools collection" },
    "/teachers/{teacherId}": { "schema": "Teacher", "description": "Teachers collection" },
    "/school_students/{studentId}": { "schema": "SchoolStudent", "description": "Teacher-managed students collection" },
    "/classes/{classId}": { "schema": "ClassRoom", "description": "Classes collection" },
    "/class_sessions/{sessionId}": { "schema": "ClassSession", "description": "Live class sessions collection" },
    "/student_help_requests/{requestId}": { "schema": "StudentHelpRequest", "description": "Student help requests collection" },
    "/homework_assignments/{homeworkId}": { "schema": "HomeworkAssignment", "description": "Homework assignments collection" },
    "/exit_tickets/{ticketId}": { "schema": "ExitTicket", "description": "Exit tickets collection" },
    "/assessments/{assessmentId}": { "schema": "Assessment", "description": "Assessments collection" },
    "/student_journey_events/{eventId}": { "schema": "StudentJourneyEvent", "description": "Student journey timeline events collection" },
    "/security_audit_logs/{logId}": { "schema": "SecurityAuditLog", "description": "Security audit logs collection" },
    "/leaderboard/{document}": { "schema": "LeaderboardEntry", "description": "Public leaderboard collection" },
    "/reviews/{reviewId}": { "schema": "Review", "description": "User reviews and ratings collection" },
    "/survey_responses/{surveyId}": { "schema": "SurveyResponse", "description": "Anonymized user feedback surveys collection" }
  }
}
