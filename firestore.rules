rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isTeacher() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) ||
        (request.auth.token != null && request.auth.token.role == 'TEACHER')
      );
    }

    function isNonEmptyString(str, maxLen) {
      return str is string && str.size() > 0 && str.size() <= maxLen;
    }

    // Public Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isNonEmptyString(request.resource.data.userId, 128) &&
                       isNonEmptyString(request.resource.data.displayName, 100) &&
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       isNonEmptyString(request.resource.data.reviewText, 2000);
      allow update, delete: if false;
    }

    // Pseudonymous Leaderboard (No PII, no passwords, only username and scores)
    match /leaderboard/{docId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
                               !('real_first_name' in request.resource.data) &&
                               !('email' in request.resource.data) &&
                               !('password' in request.resource.data);
      allow delete: if false;
    }

    // User profiles & settings (Protected)
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        (resource.data.parent_uids != null && resource.data.parent_uids.hasAny([request.auth.uid]))
      );
      allow create: if isAuthenticated() &&
                       (request.auth.uid == userId || isTeacher()) &&
                       !('password' in request.resource.data);
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'accountType', 'teacher_id', 'class_id', 'password'])) ||
        ((resource.data.teacher_id == request.auth.uid || resource.data.teacherId == request.auth.uid) && !('password' in request.resource.data)) ||
        (resource.data.parent_uids != null && resource.data.parent_uids.hasAny([request.auth.uid]) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parent_uids']))
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }

    // Unique Username registry (No passwords allowed in document)
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && !('password' in request.resource.data);
      allow update: if isAuthenticated() && isOwner(resource.data.uid) && !('password' in request.resource.data);
      allow delete: if isAuthenticated() && isOwner(resource.data.uid);
    }

    // School organizations
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // Verified Teachers
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == teacherId && !('password' in request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid == teacherId;
    }

    // Teacher Roster: School Students (Isolated by teacher and student)
    match /school_students/{studentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == studentId ||
        resource.data.id == request.auth.uid ||
        resource.data.authUid == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        (resource.data.parent_uids != null && resource.data.parent_uids.hasAny([request.auth.uid]))
      );
      allow create: if isAuthenticated() && (
        request.resource.data.teacher_id == request.auth.uid ||
        request.resource.data.teacherId == request.auth.uid
      ) && !('password' in request.resource.data);
      allow update: if isAuthenticated() && (
        (resource.data.teacher_id == request.auth.uid || resource.data.teacherId == request.auth.uid) &&
        !('password' in request.resource.data)
      ) || (
        (request.auth.uid == studentId || resource.data.id == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacher_id', 'teacherId', 'class_id', 'classId', 'real_first_name', 'password'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }

    // Classroom metadata
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.teacherId == request.auth.uid || request.resource.data.teacher_id == request.auth.uid);
      allow update, delete: if isAuthenticated() && (resource.data.teacherId == request.auth.uid || resource.data.teacher_id == request.auth.uid);
    }

    // Live Classroom Sessions
    match /class_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.teacher_id == request.auth.uid || request.resource.data.teacherId == request.auth.uid);
      allow update: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeStudents', 'studentResponses', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && (resource.data.teacher_id == request.auth.uid || resource.data.teacherId == request.auth.uid);
    }

    // Student Help Requests (Isolated: visible ONLY to student and their authorized teacher)
    match /student_help_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.student_id == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        resource.data.authUid == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.student_id == request.auth.uid ||
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.authUid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.student_id == request.auth.uid ||
        resource.data.studentId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }

    // Classroom Misconceptions & Interventions (Teacher-managed)
    match /class_misconceptions/{misconceptionId} {
      allow read, write: if isTeacher();
    }
    match /intervention_groups/{groupId} {
      allow read, write: if isTeacher();
    }

    // Homework Assignments & Exit Tickets
    match /homework_assignments/{homeworkId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        request.resource.data.teacher_id == request.auth.uid ||
        request.resource.data.teacherId == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }
    match /homework_submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.student_id == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.student_id == request.auth.uid ||
        request.resource.data.studentId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }

    match /exit_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        request.resource.data.teacher_id == request.auth.uid ||
        request.resource.data.teacherId == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }
    match /exit_ticket_results/{resultId} {
      allow read: if isAuthenticated() && (
        resource.data.student_id == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.student_id == request.auth.uid ||
        request.resource.data.studentId == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }

    // Student Journey Replays (Isolated to student and teacher)
    match /student_journey_events/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.student_id == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }

    // Assessments & Submissions
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (
        request.resource.data.teacher_id == request.auth.uid ||
        request.resource.data.teacherId == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }
    match /assessment_submissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.student_id == request.auth.uid ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.student_id == request.auth.uid ||
        request.resource.data.studentId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
    }

    // Parent Link Codes & Parent-Child Relationships
    match /parent_invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }
    match /parent_children/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.parent_uid == request.auth.uid ||
        resource.data.student_uid == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.parent_uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.parent_uid == request.auth.uid;
    }
    match /parent_weekly_reports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.parent_uid == request.auth.uid ||
        resource.data.teacher_id == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        request.resource.data.teacher_id == request.auth.uid ||
        request.resource.data.parent_uid == request.auth.uid
      );
    }

    // SATs Progress & Revision Packs
    match /sats_progress/{studentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == studentId ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create, update: if isAuthenticated() && (
        request.auth.uid == studentId ||
        request.resource.data.teacher_id == request.auth.uid ||
        request.resource.data.teacherId == request.auth.uid
      );
      allow delete: if isAuthenticated() && request.auth.uid == studentId;
    }

    // Security Audit Logs (Append-only by authenticated users, readable by authorized teachers)
    match /security_audit_logs/{logId} {
      allow read: if isTeacher();
      allow create: if isAuthenticated() && !('password' in request.resource.data);
      allow update, delete: if false;
    }

    // DEFAULT DENY: Deny all unhandled matches
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
