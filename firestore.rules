rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // SECURITY & VALIDATION HELPER FUNCTIONS
    // =========================================================================

    function isNotTooLarge(val) {
      return val is string && val.size() <= 2000;
    }

    function isValidNumber(val, minVal, maxVal) {
      return val is number && val >= minVal && val <= maxVal;
    }

    // =========================================================================
    // COLLECTION-SPECIFIC ZERO-TRUST RULES
    // =========================================================================

    // User Profiles & Progress
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Username Registry
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // School Organizations & Teachers
    match /schools/{schoolId} {
      allow read, write: if true;
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // School Students & Rosters
    match /school_students/{studentId} {
      allow read, write: if true;
    }

    // Classes, Classrooms, Announcements & Posts
    match /classes/{classId} {
      allow read, write: if true;
    }

    match /class_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /class_announcements/{announcementId} {
      allow read, write: if true;
    }

    match /class_posts/{postId} {
      allow read, write: if true;
    }

    match /class_requests/{requestId} {
      allow read, write: if true;
    }

    // Student Help Requests
    match /student_help_requests/{requestId} {
      allow read, write: if true;
    }

    // Misconceptions & Intervention Groups
    match /class_misconceptions/{misconceptionId} {
      allow read, write: if true;
    }

    match /intervention_groups/{groupId} {
      allow read, write: if true;
    }

    // Homework & Submissions (supports both /homework and /homework_assignments)
    match /homework/{homeworkId} {
      allow read, write: if true;
    }

    match /homework_assignments/{homeworkId} {
      allow read, write: if true;
    }

    match /homework_submissions/{submissionId} {
      allow read, write: if true;
    }

    // Assessments & Exit Tickets
    match /exit_tickets/{ticketId} {
      allow read, write: if true;
    }

    match /exit_ticket_results/{resultId} {
      allow read, write: if true;
    }

    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    match /assessment_submissions/{submissionId} {
      allow read, write: if true;
    }

    // Multiplayer Arena Games & Matchmaking Queue
    match /arena_games/{gameId} {
      allow read, write: if true;
    }

    match /matchmaking_queue/{queueId} {
      allow read, write: if true;
    }

    // Student Journey Replays & Events
    match /student_journey_events/{eventId} {
      allow read, write: if true;
    }

    // Parent Reports & Invitations
    match /parent_invitations/{invitationId} {
      allow read, write: if true;
    }

    match /parent_children/{docId} {
      allow read, write: if true;
    }

    match /parent_weekly_reports/{reportId} {
      allow read, write: if true;
    }

    // SATs Progress & Revision
    match /sats_progress/{studentId} {
      allow read, write: if true;
    }

    // Leaderboard
    match /leaderboard/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Reviews & Public Feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Survey Responses & Research Intelligence (Anonymized User Submissions)
    match /survey_responses/{surveyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Developer Guestbook
    match /developer_guestbook/{entryId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Shop Items & System State
    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /system_state/{stateId} {
      allow read, write: if true;
    }

    // Security Audit Logs (Append-only)
    match /security_audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Deny all other unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
