rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTeacher() {
      return isAuthenticated();
    }

    // Reviews & Public Feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Leaderboard (Public read, strict type/range validated write)
    match /leaderboard/{docId} {
      allow read: if true;
      allow create, update: if isAuthenticated() 
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 10000
                    && request.resource.data.username is string
                    && request.resource.data.username.size() < 30;
      allow delete: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Username Registry
    match /usernames/{username} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // School Organizations & Teachers
    match /schools/{schoolId} {
      allow read, write: if isAuthenticated();
    }

    match /teachers/{teacherId} {
      allow read, write: if isAuthenticated();
    }

    // School Students (Teacher Rosters & Student PIN Lookups)
    match /school_students/{studentId} {
      allow read: if true; // Allow student PIN queries on login
      allow create, update, delete: if isAuthenticated();
    }

    // Classes & Classrooms
    match /classes/{classId} {
      allow read, write: if isAuthenticated();
    }

    // Live Classroom Sessions
    match /class_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Student Help Center & Requests
    match /student_help_requests/{requestId} {
      allow read, write: if true;
    }

    // Class Misconceptions & Intervention Groups
    match /class_misconceptions/{misconceptionId} {
      allow read, write: if true;
    }

    match /intervention_groups/{groupId} {
      allow read, write: if true;
    }

    // Homework Assignments & Submissions
    match /homework_assignments/{homeworkId} {
      allow read, write: if true;
    }

    match /homework_submissions/{submissionId} {
      allow read, write: if true;
    }

    // Exit Tickets & Assessment Results
    match /exit_tickets/{ticketId} {
      allow read, write: if true;
    }

    match /exit_ticket_results/{resultId} {
      allow read, write: if true;
    }

    // Assessments & Submissions
    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    match /assessment_submissions/{submissionId} {
      allow read, write: if true;
    }

    // Student Journey Replays & Events
    match /student_journey_events/{eventId} {
      allow read, write: if true;
    }

    // Parent Invitations & Reports
    match /parent_invitations/{invitationId} {
      allow read, write: if true;
    }

    match /parent_children/{docId} {
      allow read, write: if true;
    }

    match /parent_weekly_reports/{reportId} {
      allow read, write: if true;
    }

    // SATs Progress & Revision
    match /sats_progress/{studentId} {
      allow read, write: if true;
    }

    // Security Audit Logs
    match /security_audit_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
