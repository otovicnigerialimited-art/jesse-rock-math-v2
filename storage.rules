rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)')
        && request.resource.size <= 5 * 1024 * 1024; // 5MB max
    }

    function isDocumentFile() {
      return request.resource.contentType.matches('(application/pdf|image/jpeg|image/png)')
        && request.resource.size <= 10 * 1024 * 1024; // 10MB max
    }

    // =========================================================================
    // STORAGE PATH PERMISSIONS
    // =========================================================================

    // User avatars & custom graphics
    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isImageFile();
    }

    // Homework & student attachments
    match /homework/{classId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isDocumentFile();
    }

    // Public game assets (Read-Only)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
